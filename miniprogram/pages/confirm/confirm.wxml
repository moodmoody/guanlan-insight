<view class="page">
  <view class="page-title">确认分析任务</view>
  <view class="page-subtitle">我们先确认系统理解是否正确，再开始生成报告。</view>

  <view class="card section">
    <view class="field">
      <view class="label">分析主题</view>
      <view class="value">{{task.query}}</view>
    </view>
    <view class="field">
      <view class="label">分析类型</view>
      <view class="value strong">{{task.analysisLabel}}</view>
    </view>
    <view class="field">
      <view class="label">时间范围</view>
      <view class="chip-row">
        <view wx:for="{{ranges}}" wx:key="*this" class="range-chip {{task.timeRange === item ? 'active' : ''}}" data-value="{{item}}" bindtap="setRange">{{item}}</view>
      </view>
    </view>
    <view class="field">
      <view class="label">重点维度</view>
      <view>
        <text wx:for="{{task.focus}}" wx:key="*this" class="tag">{{item}}</text>
      </view>
    </view>
  </view>

  <button class="primary-button section" bindtap="confirmTask">确认分析</button>
  <button class="secondary-button section" bindtap="goBack">返回修改</button>
</view>
